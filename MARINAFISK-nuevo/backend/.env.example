# Copia este archivo a ".env" y ajusta los valores si hace falta.
# Con la instalación por defecto de PostgreSQL en el ordenador de Víctor
# (ver README.md), estos valores ya deberían funcionar tal cual.

PGHOST=localhost
PGPORT=5432
PGDATABASE=marinafisk
PGUSER=marinafisk_app
PGPASSWORD=marinafisk_dev

# Puerto en el que escucha este backend (la API).
PORT=3001
