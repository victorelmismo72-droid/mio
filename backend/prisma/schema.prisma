// Esquema de base de datos - Fase 1 de MARINAFISK.
//
// Alcance de esta fase (ver FASE_1_base_de_datos_backend_MARINAFISK.md):
// solo tablas y acceso a datos, SIN logica de negocio (eso es la Fase 2) y
// SIN facturas/pagos todavia (eso es la Fase 4, que depende de que esta fase
// y la Fase 2 esten terminadas). El detalle de cada tabla esta explicado en
// MARINAFISK-nuevo/02_ESQUEMA_BASE_DATOS_PROPUESTO.md - este fichero es la
// version tecnica (Prisma) de ese borrador ya aprobado por Victor.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// Clientes / Proveedores / Articulos (catalogos maestros)
// ---------------------------------------------------------------------

enum TipoIvaCliente {
  NORMAL
  INTRACOMUNITARIO
  RECARGO_EQUIVALENCIA
}

model Cliente {
  id              Int            @id @default(autoincrement())
  codigo          String         @unique
  nombre          String
  cif             String?
  direccion       String?
  cp              String?
  poblacion       String?
  provincia       String?
  telefono        String?
  email           String?
  formaPago       String?        @map("forma_pago")
  agencia         String?
  tipoIva         TipoIvaCliente @map("tipo_iva")
  formatoEtiqueta String?        @map("formato_etiqueta")
  creadoEn        DateTime       @default(now()) @map("creado_en")
  modificadoEn    DateTime       @updatedAt @map("modificado_en")

  pedidos Pedido[]

  @@map("clientes")
}

enum TipoIvaProveedor {
  NACIONAL
  INTRACOMUNITARIO
}

model Proveedor {
  id           Int              @id @default(autoincrement())
  codigo       String           @unique
  nombre       String
  esSubastaOp  Boolean          @default(false) @map("es_subasta_op")
  tipoIva      TipoIvaProveedor @map("tipo_iva")
  notas        String?
  creadoEn     DateTime         @default(now()) @map("creado_en")
  modificadoEn DateTime         @updatedAt @map("modificado_en")

  compras  Compra[]
  partidas Partida[]

  @@map("proveedores")
}

model Articulo {
  id                 Int      @id @default(autoincrement())
  codigo             String   @unique
  descripcion        String
  tipo               String?
  pvp1               Decimal? @db.Decimal(10, 2)
  pvp2               Decimal? @db.Decimal(10, 2)
  ivaPct             Decimal  @default(10) @db.Decimal(5, 2) @map("iva_pct")
  familiaPrefijo     String?  @map("familia_prefijo")
  primeraPalabraDesc String?  @map("primera_palabra_desc")
  cientifico         String?
  zonaFao            String?  @map("zona_fao")
  subzona            String?
  artePesca          String?  @map("arte_pesca")
  barco              String?
  pesoEtiqueta       String?  @map("peso_etiqueta")
  calibre            String?
  modoPresentacion   String?  @map("modo_presentacion")
  formaObtencion     String?  @map("forma_obtencion")
  nombreFrances      String?  @map("nombre_frances")
  nombreItaliano     String?  @map("nombre_italiano")
  creadoEn           DateTime @default(now()) @map("creado_en")
  modificadoEn       DateTime @updatedAt @map("modificado_en")

  compraLineas      CompraLinea[]
  pedidoLineas      PedidoLinea[]
  traspasoLineas    TraspasoLinea[]
  repartoLineas     RepartoLinea[]
  listaPrecioLineas ListaPrecioLinea[]

  @@map("articulos")
}

// ---------------------------------------------------------------------
// Compras y Partidas - "dato sagrado": sin UPDATE/DELETE desde la API
// (ver Fase 0 punto 3 y Fase 1 punto 3). El propio backend (src/routes)
// solo expone POST y GET para estas dos tablas, nunca PUT ni DELETE.
// ---------------------------------------------------------------------

// numeroPartida NO es unique aqui: leyendo grabarCompra() en el HTML actual,
// varias compras (albaranes) del MISMO proveedor en el MISMO dia comparten
// el mismo numero de partida - la partida agrupa compras, no es 1:1 con una.
// Ver 02_ESQUEMA_BASE_DATOS_PROPUESTO.md, tabla `compras`, para el detalle
// de esta correccion (05/09/2026) sobre la primera version de este esquema.
model Compra {
  id                      Int      @id @default(autoincrement())
  numeroPartida           Int      @map("numero_partida")
  fecha                   DateTime @db.Date
  albaranProveedor        String?  @map("albaran_proveedor")
  proveedorId             Int      @map("proveedor_id")
  proveedor               Proveedor @relation(fields: [proveedorId], references: [id])
  proveedorNombreSnapshot String   @map("proveedor_nombre_snapshot")
  totalKilos              Decimal  @db.Decimal(10, 2) @map("total_kilos")
  totalBaseZgz            Decimal  @db.Decimal(10, 2) @map("total_base_zgz")
  totalBaseReal           Decimal  @db.Decimal(10, 2) @map("total_base_real")
  totalIva                Decimal  @db.Decimal(10, 2) @map("total_iva")
  totalFactura            Decimal  @db.Decimal(10, 2) @map("total_factura")
  puestoOrigen            String   @map("puesto_origen")
  creadoEn                DateTime @default(now()) @map("creado_en")

  lineas CompraLinea[]

  @@index([numeroPartida])
  @@map("compras")
}

model CompraLinea {
  id             Int      @id @default(autoincrement())
  compraId       Int      @map("compra_id")
  compra         Compra   @relation(fields: [compraId], references: [id])
  articuloId     Int      @map("articulo_id")
  articulo       Articulo @relation(fields: [articuloId], references: [id])
  cajas          Int?
  kilos          Decimal  @db.Decimal(10, 2)
  precioKg       Decimal  @db.Decimal(10, 4) @map("precio_kg")
  baseZgz        Decimal  @db.Decimal(10, 2) @map("base_zgz")
  baseZgzConIva  Decimal  @default(0) @db.Decimal(10, 2) @map("base_zgz_con_iva")
  op2Importe     Decimal  @default(0) @db.Decimal(10, 2) @map("op2_importe")
  baseReal       Decimal  @db.Decimal(10, 2) @map("base_real")
  ivaImporte     Decimal  @db.Decimal(10, 2) @map("iva_importe")
  totalFactura   Decimal  @db.Decimal(10, 2) @map("total_factura")
  control        Boolean  @default(false)
  creadoEn       DateTime @default(now()) @map("creado_en")

  @@map("compra_lineas")
}

// partidas: registro CANONICO de que numeros de partida existen (no es 1:1
// con una compra - ver nota en el modelo Compra - varias filas de `compras`
// referencian el mismo numero_partida). kilos_disponibles NO se guarda como
// columna (se calcula en Fase 2 sumando todas las compras de ese
// numero_partida); aqui se guarda el estado real de cierre manual (equivale
// a `localStorage['partidas_cerradas_manual']` de hoy) y la asignacion
// automatica del numero.
//
// Regla de negocio (confirmada por Victor, 12/09/2026): por defecto hay UNA
// SOLA partida "principal" por dia+proveedor (esPrincipal=true) - es la que
// se reutiliza automaticamente en cada compra nueva de ese proveedor ese
// dia, igual que en el Excel. En casos raros (necesidad de produccion) se
// puede forzar una partida NUEVA distinta para ese mismo dia+proveedor
// (esPrincipal=false) - nunca se sugiere sola, solo se usa si se elige
// explicitamente cada vez. El indice unico parcial de mas abajo (anadido a
// mano en la migracion, Prisma no soporta indices parciales en el schema)
// garantiza a nivel de base de datos que nunca haya dos principales para el
// mismo dia+proveedor, incluso si dos puestos graban a la vez.
model Partida {
  id            Int       @id @default(autoincrement())
  numeroPartida Int       @unique @default(dbgenerated("nextval('partidas_numero_partida_seq')")) @map("numero_partida")
  fecha         DateTime  @db.Date
  proveedorId   Int       @map("proveedor_id")
  proveedor     Proveedor @relation(fields: [proveedorId], references: [id])
  esPrincipal   Boolean   @default(true) @map("es_principal")
  cerradaManual Boolean   @default(false) @map("cerrada_manual")
  cerradaEn     DateTime? @map("cerrada_en")
  cerradaPor    String?   @map("cerrada_por")
  creadoEn      DateTime  @default(now()) @map("creado_en")

  // Indice unico parcial real: UNIQUE(fecha, proveedor_id) WHERE es_principal
  // - se añade a mano en la migracion (ver migration.sql), Prisma no lo
  // expresa en el schema. Este @@index normal es solo para acelerar las
  // consultas, NO es la garantia de unicidad.
  @@index([fecha, proveedorId])
  @@map("partidas")
}

// ---------------------------------------------------------------------
// Pedidos (albaranes de venta)
// ---------------------------------------------------------------------

model Pedido {
  id              Int      @id @default(autoincrement())
  numero          Int      @unique
  fecha           DateTime @db.Date
  clienteId       Int      @map("cliente_id")
  cliente         Cliente  @relation(fields: [clienteId], references: [id])
  // "Foto" de los datos del cliente en el momento del pedido (el HTML actual
  // guarda clienteNombre/clienteCif/clienteDir/clientePob/clienteTel en cada
  // pedido, ademas del codigo) - si el cliente cambia despues, el albaran ya
  // impreso no debe cambiar retroactivamente.
  clienteNombreSnapshot String  @map("cliente_nombre_snapshot")
  clienteCifSnapshot    String? @map("cliente_cif_snapshot")
  clienteDirSnapshot    String? @map("cliente_dir_snapshot")
  clientePobSnapshot    String? @map("cliente_pob_snapshot")
  clienteTelSnapshot    String? @map("cliente_tel_snapshot")
  agencia         String?
  formaPago       String?  @map("forma_pago")
  tipoIvaAplicado String   @map("tipo_iva_aplicado")
  baseImponible   Decimal  @db.Decimal(10, 2) @map("base_imponible")
  iva             Decimal  @db.Decimal(10, 2)
  total           Decimal  @db.Decimal(10, 2)
  puestoOrigen    String   @map("puesto_origen")
  creadoEn        DateTime @default(now()) @map("creado_en")
  modificadoEn    DateTime @updatedAt @map("modificado_en")

  lineas PedidoLinea[]

  @@map("pedidos")
}

model PedidoLinea {
  id                 Int      @id @default(autoincrement())
  pedidoId           Int      @map("pedido_id")
  pedido             Pedido   @relation(fields: [pedidoId], references: [id])
  articuloId         Int      @map("articulo_id")
  articulo           Articulo @relation(fields: [articuloId], references: [id])
  descripcionEditada String?  @map("descripcion_editada")
  cantidad           Decimal? @db.Decimal(10, 2)
  peso               Decimal  @db.Decimal(10, 2)
  precio             Decimal  @db.Decimal(10, 4)
  descuento          Decimal  @default(0) @db.Decimal(5, 2)
  ivaPct             Decimal  @db.Decimal(5, 2) @map("iva_pct")
  total              Decimal  @db.Decimal(10, 2)
  // Numero de partida asignado a esta linea (vacio/null = pendiente de
  // asignar, reemplaza a la "pantalla de excepciones" actual: es un filtro
  // sobre esta misma tabla). NO es una FK a `partidas` - esa tabla solo
  // guarda cierres manuales, no existe una fila por cada numero de partida.
  partidaNumero      Int?     @map("partida_numero")

  @@map("pedido_lineas")
}

// ---------------------------------------------------------------------
// Traspasos internos y Repartos
// ---------------------------------------------------------------------

model Traspaso {
  id           Int      @id @default(autoincrement())
  numero       Int      @unique
  fecha        DateTime @db.Date
  totalKg      Decimal  @db.Decimal(10, 2) @map("total_kg")
  base         Decimal  @db.Decimal(10, 2)
  total        Decimal  @db.Decimal(10, 2)
  puestoOrigen String   @map("puesto_origen")
  creadoEn     DateTime @default(now()) @map("creado_en")

  lineas TraspasoLinea[]

  @@map("traspasos")
}

model TraspasoLinea {
  id         Int      @id @default(autoincrement())
  traspasoId Int      @map("traspaso_id")
  traspaso   Traspaso @relation(fields: [traspasoId], references: [id])
  articuloId Int      @map("articulo_id")
  articulo   Articulo @relation(fields: [articuloId], references: [id])
  cantidad   Decimal? @db.Decimal(10, 2)
  peso       Decimal  @db.Decimal(10, 2)
  // Corregido el 12/09/2026 (desajuste real, se llamaba "partidaId"): esto es
  // el NUMERO de partida, igual que PedidoLinea.partidaNumero - no una FK a
  // la tabla `partidas` (esa tabla no tiene una fila por cada numero, ver el
  // comentario del modelo Partida mas arriba). Un traspaso a Zaragoza
  // consume kilos de una partida exactamente igual que un pedido, por eso
  // Fase 2 (margen) suma ambos al calcular kilos disponibles.
  partidaNumero Int?   @map("partida_numero")

  @@map("traspaso_lineas")
}

model Reparto {
  id                 Int      @id @default(autoincrement())
  numero             Int      @unique
  fecha              DateTime @db.Date
  destinatarioNombre String?  @map("destinatario_nombre")
  destinatarioCiudad String?  @map("destinatario_ciudad")
  conductor          String?
  totalCajas         Int?     @map("total_cajas")
  totalKg            Decimal  @db.Decimal(10, 2) @map("total_kg")
  puestoOrigen       String   @map("puesto_origen")
  creadoEn           DateTime @default(now()) @map("creado_en")

  lineas RepartoLinea[]

  @@map("repartos")
}

model RepartoLinea {
  id         Int      @id @default(autoincrement())
  repartoId  Int      @map("reparto_id")
  reparto    Reparto  @relation(fields: [repartoId], references: [id])
  articuloId Int      @map("articulo_id")
  articulo   Articulo @relation(fields: [articuloId], references: [id])
  cantidad   Decimal? @db.Decimal(10, 2)
  peso       Decimal  @db.Decimal(10, 2)

  @@map("reparto_lineas")
}

// ---------------------------------------------------------------------
// Listas de precio (Pescaderias / Mayoristas) - independientes entre si
// ---------------------------------------------------------------------

enum TipoListaPrecio {
  MAYORISTA
  PESCADERIA
}

enum ModoListaPrecio {
  AUTO
  MANUAL
}

model ListaPrecio {
  id       Int             @id @default(autoincrement())
  tipo     TipoListaPrecio
  fecha    DateTime        @db.Date
  modo     ModoListaPrecio
  creadoEn DateTime        @default(now()) @map("creado_en")

  lineas ListaPrecioLinea[]

  @@unique([tipo, fecha])
  @@map("listas_precio")
}

// Corregido el 13/09/2026 (desajuste real, ver Fase 2 punto 5): en el modo
// manual del HTML actual, cada fila es un producto escrito LIBREMENTE
// (agregarFilaManualPrecio: solo texto, sin ningún selector de catálogo) -
// no siempre corresponde a un articulo del maestro. articuloId pasa a ser
// opcional y se añade descripcionLibre para ese caso; una fila debe traer
// uno de los dos (comprobado en la app Y con un CHECK en la base de datos,
// añadido a mano en la migración - ver migration.sql).
// coste y existencias son la "version interna" (Fase 0 punto 9 / Fase 2
// punto 5): coste de referencia (solo para uso interno, nunca en la imagen
// de cliente) y existencias en texto libre ("AGOTADO", "POCAS"...) además
// de un número exacto, igual que en partidas.
model ListaPrecioLinea {
  id               Int         @id @default(autoincrement())
  listaPrecioId    Int         @map("lista_precio_id")
  listaPrecio      ListaPrecio @relation(fields: [listaPrecioId], references: [id])
  articuloId       Int?        @map("articulo_id")
  articulo         Articulo?   @relation(fields: [articuloId], references: [id])
  descripcionLibre String?     @map("descripcion_libre")
  precio           Decimal     @db.Decimal(10, 2)
  coste            Decimal?    @db.Decimal(10, 2)
  existencias      String?

  @@map("lista_precio_lineas")
}

// ---------------------------------------------------------------------
// Log basico de escrituras (Fase 1 punto 3: util para depurar
// problemas de sincronizacion mas adelante, en la Fase 3).
// ---------------------------------------------------------------------

model LogEscritura {
  id           Int      @id @default(autoincrement())
  tabla        String
  operacion    String
  registroId   Int?     @map("registro_id")
  puestoOrigen String?  @map("puesto_origen")
  creadoEn     DateTime @default(now()) @map("creado_en")

  @@map("log_escrituras")
}

// ---------------------------------------------------------------------
// Proteccion contra doble grabacion por clic repetido (CORRECCIONES_02-09-2026
// punto 1; ver FASE_0 punto 11.3 y FASE_1 criterios de cierre) - A NIVEL DE
// SERVIDOR, no solo deshabilitando el boton en pantalla como hace hoy el
// HTML. El cliente debe generar una clave unica por intento de guardado (ej.
// un UUID generado al pulsar "Grabar") y reenviar la MISMA clave si reintenta
// ese mismo clic - nunca una clave nueva para el mismo intento.
model ClaveIdempotencia {
  id           Int       @id @default(autoincrement())
  clave        String    @unique
  ruta         String
  estado       String    // EN_PROCESO | COMPLETADA
  statusHttp   Int?
  respuesta    Json?
  creadoEn     DateTime  @default(now()) @map("creado_en")
  completadoEn DateTime? @map("completado_en")

  @@map("claves_idempotencia")
}

// ---------------------------------------------------------------------
// Copia de seguridad automatica antes de cada importacion masiva de Excel
// (mismo mecanismo que el HTML actual guarda como `compras_backup_previo`
// en localStorage antes de reimportar el Excel de COMPRAS). No sustituye a
// un backup real de la base de datos - es solo la foto de "que compras
// afecto esta importacion" por si hay que revertir algo a mano.
// ---------------------------------------------------------------------

model ImportacionBackup {
  id         Int      @id @default(autoincrement())
  tipo       String   // ej. "compras_excel"
  contenido  Json     // snapshot de los registros afectados ANTES de la importacion
  creadoEn   DateTime @default(now()) @map("creado_en")

  @@map("importaciones_backup")
}
