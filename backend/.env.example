# Copia este fichero a ".env" y ajusta los valores para tu ordenador.
# No subir nunca el fichero ".env" real (con la contraseña) al repositorio.

# Cadena de conexion a PostgreSQL: usuario, contraseña, host, puerto y nombre de la base de datos.
DATABASE_URL="postgresql://marinafisk:marinafisk@localhost:5432/marinafisk?schema=public"

# Puerto en el que arranca el servidor backend.
PORT=3000

# Puesto donde corre este backend (CORU o PANC) - se usa para etiquetar quien crea cada registro.
PUESTO_ORIGEN=CORU
